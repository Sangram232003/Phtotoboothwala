# PHOTO BOOTH WALA — Environment Configuration Template

# Server Configuration
PORT=3000
JWT_SECRET=your_super_secret_jwt_key_here

# Contact Details
WHATSAPP_NUMBER=919876543210
ADMIN_EMAIL=admin@photoboothwala.com

# Development / Testing Mode Configuration
# Set EMAIL_MODE=test or EMAIL_DRY_RUN=true during development to render HTML templates without sending real emails
EMAIL_MODE=test
EMAIL_DRY_RUN=true

# Production Booking Email System (SMTP Configuration)
# When client provides production credentials, set EMAIL_DRY_RUN=false and configure below:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_test_email@gmail.com
SMTP_PASSWORD=your_test_app_password
MAIL_FROM="Photo Booth Wala <your_test_email@gmail.com>"
